# URL pubblico del sito (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" solo al lancio reale: finché è demo resta false (noindex globale + robots Disallow)
NEXT_PUBLIC_ALLOW_INDEXING=false
# Dominio Plausible (vuoto = analytics disattivati)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Link del credito nel footer
NEXT_PUBLIC_LIMITLESS_URL=https://example.com
